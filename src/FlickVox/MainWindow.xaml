<Window x:Class="FlickVox.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FlickVox" Width="790" Height="650" MinWidth="620" MinHeight="500" WindowStartupLocation="CenterScreen">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><StackPanel><TextBlock Text="FlickVox" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Accent}"/></StackPanel><Button DockPanel.Dock="Right" Content="Open overlay  Ctrl + Alt + T" Click="OpenOverlay"/></DockPanel>
  <Grid Grid.Row="1" Margin="0,24,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
   <StackPanel><TextBox x:Name="Input" Height="210" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="17" KeyDown="InputKeyDown" ToolTip="Type something to speak..."/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Speak" Background="{StaticResource Accent}" Click="Speak"/><Button Content="Stop" Click="Stop"/><Button Content="Repeat" Click="Repeat"/><Button Content="Preview voice" Click="Preview"/></StackPanel><TextBlock Text="Speed" Margin="4,16,0,2"/><DockPanel><TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" Text="1.00x"/><Slider x:Name="Speed" Minimum="0.6" Maximum="1.8" Value="1" TickFrequency=".1" ValueChanged="SpeedChanged"/></DockPanel><TextBlock Text="Recent messages" Margin="4,16,0,4" FontWeight="SemiBold"/><ListBox x:Name="History" Height="120" MouseDoubleClick="HistorySpeak"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="22,0,0,0"><TextBlock Text="Voice" FontWeight="SemiBold"/><ComboBox x:Name="Voice" DisplayMemberPath="DisplayName" SelectionChanged="VoiceChanged" Margin="0,6,0,14"/><TextBlock Text="Output device" FontWeight="SemiBold"/><ComboBox x:Name="Output" Margin="0,6,0,14"/><TextBlock Text="Saved phrases" FontWeight="SemiBold"/><ListBox x:Name="Phrases" Height="160" DisplayMemberPath="Name" MouseDoubleClick="PhraseSpeak"/><Button Content="Save current phrase" Click="SavePhrase"/><Button Content="Voice manager" Click="VoiceManager"/><CheckBox x:Name="HideAfter" Content="Hide overlay after speaking" IsChecked="True" Margin="4,16"/></StackPanel>
  </Grid>
  <TextBlock Grid.Row="2" Text="Enter speaks · Shift + Enter adds a line · Esc stops speech" Foreground="{StaticResource Muted}"/>
 </Grid>
</Window>
