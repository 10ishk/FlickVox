<Window x:Class="FlickVox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlickVox" Icon="Assets/FlickVox.ico" Width="520" Height="500" MinWidth="390" MinHeight="370"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Canvas}"
        Foreground="{DynamicResource Brush.Text}" TextElement.Foreground="{DynamicResource Brush.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="WindowPreviewKeyDown"
        FontFamily="{StaticResource Font.UI}">
  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="20,14,20,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Brush.Brand}" Margin="0,0,9,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle Width="3" Height="8" Fill="White" Margin="1"/><Rectangle Width="3" Height="14" Fill="White" Margin="1"/><Rectangle Width="3" Height="6" Fill="White" Margin="1"/>
          </StackPanel>
        </Border>
        <TextBlock Text="FlickVox" FontFamily="{StaticResource Font.Brand}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Fill="{DynamicResource Brush.Signal}" Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" Text="Checking" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Click="OpenOverlay" ToolTip="Open quick overlay" AutomationProperties.Name="Open overlay" Padding="9,5">
          <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Open}" Fill="{DynamicResource Brush.Text}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="Overlay"/></StackPanel>
        </Button>
        <Button Style="{StaticResource IconButton}" Click="OpenSettings" Margin="5,0,0,0" ToolTip="Settings" AutomationProperties.Name="Open settings">
          <Path Data="{StaticResource Icon.Settings}" Fill="{DynamicResource Brush.TextSecondary}" Width="18" Height="18" Stretch="Uniform"/>
        </Button>
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20,0,20,16">
        <Border x:Name="Notice" Visibility="Collapsed" Background="{DynamicResource Brush.SurfaceRaised}"
                BorderBrush="{DynamicResource Brush.StrokeControl}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,10">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}"/>
            <Button x:Name="NoticeAction" Grid.Column="1" Content="Set up" Click="OpenSetup" Margin="8,0,0,0" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <Border x:Name="ComposerCard" Style="{StaticResource Card}" Height="158" Padding="12" CornerRadius="15">
          <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <TextBox x:Name="Input" FontSize="19" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       KeyDown="InputKeyDown" TextChanged="InputChanged" AutomationProperties.Name="Text to speak"/>
              <TextBlock x:Name="InputPlaceholder" Text="Type something to say…" FontSize="19"
                         Foreground="{DynamicResource Brush.TextTertiary}" IsHitTestVisible="False"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,7,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Enter to speak · Shift+Enter for new line" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="Save" Click="SavePhrase" ToolTip="Save phrase · Ctrl+S" Visibility="Collapsed" Height="27" Margin="5,0,5,0"/>
                <Button x:Name="ClearButton" Style="{StaticResource IconButton}" Height="27" Click="ClearInput" ToolTip="Clear · Ctrl+L"
                        AutomationProperties.Name="Clear text" Visibility="Collapsed">
                  <Path Data="{StaticResource Icon.Dismiss}" Fill="{DynamicResource Brush.TextSecondary}" Width="17" Height="17" Stretch="Uniform"/>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <WrapPanel Margin="0,10,0,0">
          <Grid Margin="0,0,6,6">
            <Button x:Name="VoiceChip" Style="{StaticResource Chip}" Click="ToggleVoiceFlyout" ToolTip="Choose voice">
              <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.PersonVoice}" Fill="{DynamicResource Brush.TextSecondary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0"/>
                <TextBlock x:Name="VoiceValue" Text="Voice" TextTrimming="CharacterEllipsis" MaxWidth="112"/>
                <Path Data="{StaticResource Icon.ChevronDown}" Fill="{DynamicResource Brush.TextSecondary}" Width="10" Height="10" Stretch="Uniform" Margin="5,0,0,0"/>
              </StackPanel>
            </Button>
            <Popup x:Name="VoiceFlyout" PlacementTarget="{Binding ElementName=VoiceChip}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="FlyoutOpened">
              <Border Style="{StaticResource Flyout}" Width="285" Padding="14"><StackPanel>
                <TextBlock Text="Voice" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <ListBox x:Name="Voice" DisplayMemberPath="DisplayName" SelectionChanged="VoiceChanged" MaxHeight="220" AutomationProperties.Name="Voice"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Preview" Click="Preview"/><Button Content="Manage voices" Click="OpenVoiceManager" Margin="6,0,0,0"/></StackPanel>
              </StackPanel></Border>
            </Popup>
          </Grid>
          <Grid Margin="0,0,6,6">
            <Button x:Name="OutputChip" Style="{StaticResource Chip}" Click="ToggleOutputFlyout" ToolTip="Choose output device">
              <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Speaker2}" Fill="{DynamicResource Brush.TextSecondary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0"/>
                <TextBlock x:Name="OutputValue" Text="Default output" TextTrimming="CharacterEllipsis" MaxWidth="118"/>
                <Path Data="{StaticResource Icon.ChevronDown}" Fill="{DynamicResource Brush.TextSecondary}" Width="10" Height="10" Stretch="Uniform" Margin="5,0,0,0"/>
              </StackPanel>
            </Button>
            <Popup x:Name="OutputFlyout" PlacementTarget="{Binding ElementName=OutputChip}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="FlyoutOpened">
              <Border Style="{StaticResource Flyout}" Width="300" Padding="14"><StackPanel>
                <TextBlock Text="Output device" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <ListBox x:Name="Output" SelectionChanged="OutputChanged" MaxHeight="220" AutomationProperties.Name="Output device">
                  <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="260" ToolTip="{Binding}"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </StackPanel></Border>
            </Popup>
          </Grid>
          <Grid Margin="0,0,0,6">
            <Button x:Name="SpeedChip" Style="{StaticResource Chip}" Click="ToggleSpeedFlyout" ToolTip="Adjust speech speed">
              <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Timer}" Fill="{DynamicResource Brush.TextSecondary}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,6,0"/>
                <TextBlock x:Name="SpeedValue" Text="1.00×"/>
                <Path Data="{StaticResource Icon.ChevronDown}" Fill="{DynamicResource Brush.TextSecondary}" Width="10" Height="10" Stretch="Uniform" Margin="5,0,0,0"/>
              </StackPanel>
            </Button>
            <Popup x:Name="SpeedFlyout" PlacementTarget="{Binding ElementName=SpeedChip}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="FlyoutOpened">
              <Border Style="{StaticResource Flyout}" Width="260" Padding="14"><StackPanel>
                <TextBlock Text="Speech speed" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <Slider x:Name="Speed" Minimum="0.6" Maximum="1.8" Value="1" ValueChanged="SpeedChanged" AutomationProperties.Name="Speech speed"/>
                <TextBlock x:Name="SpeedFlyoutValue" Text="1.00×" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.AccentText}"/>
              </StackPanel></Border>
            </Popup>
          </Grid>
        </WrapPanel>
        <Grid Margin="0,8,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="RepeatButton" Content="Repeat" Click="Repeat" IsEnabled="False" HorizontalAlignment="Left" ToolTip="Repeat last message · Ctrl+R"/>
          <Button x:Name="SpeakButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="PrimaryAction" MinWidth="100">
            <StackPanel Orientation="Horizontal"><Path x:Name="PrimaryIcon" Data="{StaticResource Icon.Play}" Fill="White" Width="18" Height="18" Margin="0,0,7,0"/>
              <TextBlock x:Name="PrimaryLabel" Text="Speak" Foreground="White"/></StackPanel>
          </Button>
        </Grid>
        <Border Style="{StaticResource Card}" Padding="10" CornerRadius="12">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal"><Button x:Name="SavedTab" Style="{StaticResource TabButton}" Content="Saved" Click="ShowSaved"/>
                <Button x:Name="RecentTab" Style="{StaticResource TabButton}" Content="Recent" Click="ShowRecent" Margin="4,0,0,0"/></StackPanel>
              <Button x:Name="ExpandButton" Grid.Column="1" Content="Collapse ▴" Click="TogglePhrasePanel" AutomationProperties.Name="Expand or collapse phrases"/>
            </Grid>
            <Grid x:Name="PhraseContent" Margin="0,10,0,0" MaxHeight="210">
              <StackPanel x:Name="SavedPanel">
                <TextBlock x:Name="SavedEmpty" Text="Save a phrase to speak it with one click." Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="4,6"/>
                <ListBox x:Name="Phrases" AutomationProperties.Name="Saved phrases" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <Button Grid.Column="1" Content="Play" Tag="{Binding}" Click="PlayPhrase" ToolTip="Speak phrase"/>
                    <Button Grid.Column="2" Content="Edit" Tag="{Binding}" Click="EditPhrase" ToolTip="Edit or rename phrase" Margin="4,0,0,0"/>
                    <Button Grid.Column="3" Content="Delete" Tag="{Binding}" Click="DeletePhrase" ToolTip="Delete phrase" Margin="4,0,0,0"/>
                  </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              <StackPanel x:Name="RecentPanel" Visibility="Collapsed">
                <TextBlock x:Name="RecentEmpty" Text="Messages you speak will appear here." Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="4,6"/>
                <ListBox x:Name="History" AutomationProperties.Name="Recent messages" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <Button Grid.Column="1" Content="Play" Tag="{Binding}" Click="PlayHistory" ToolTip="Speak recent message"/>
                  </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
