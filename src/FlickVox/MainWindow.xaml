<Window x:Class="FlickVox.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FlickVox" Width="760" Height="660" MinWidth="620" MinHeight="540" WindowStartupLocation="CenterScreen"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="FlickVox" FontSize="27" FontWeight="SemiBold"/><Border Background="#243D6E" CornerRadius="10" Padding="8,3" Margin="12,3,0,0"><StackPanel Orientation="Horizontal"><Ellipse Fill="{StaticResource Accent}" Width="7" Height="7" Margin="0,0,6,0"/><TextBlock x:Name="StatusText" Text="Ready" FontSize="12"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="0,0,10,0"><TextBlock Text="Ctrl + Alt + T" Foreground="{StaticResource Muted}" FontSize="12"/></Border><Button Style="{StaticResource IconButton}" Click="OpenOverlay" ToolTip="Open compact overlay"><TextBlock Text="↗" FontSize="16"/></Button></StackPanel></Grid><Border Grid.Row="2" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="17" KeyDown="InputKeyDown" ToolTip="Type something to speak..."/><DockPanel Grid.Row="1" Margin="0,13,0,0"><TextBlock Text="Enter to speak  •  Shift + Enter for a new line" Foreground="{StaticResource Muted}" FontSize="12"/><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Height="28" Click="ClearInput" ToolTip="Clear text"><TextBlock Text="×" FontSize="18"/></Button></DockPanel></Grid></Border><StackPanel Grid.Row="4" Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Content="Speak" Click="Speak"/><Button Content="Stop" Click="Stop" Margin="8,0,0,0"/><Button Content="Repeat" Click="Repeat" Margin="8,0,0,0"/><Button Content="Preview voice" Click="Preview" Margin="8,0,0,0"/></StackPanel><Grid Grid.Row="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Voice" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Voice" DisplayMemberPath="DisplayName" SelectionChanged="VoiceChanged"/><Button Content="Manage voices" Click="OpenVoiceManager" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Output device" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Output" ToolTip="Select playback device"/><TextBlock Text="Speech speed" Style="{StaticResource FieldLabel}" Margin="0,14,0,4"/><DockPanel><TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" Text="1.00x" Foreground="{StaticResource Muted}"/><Slider x:Name="Speed" Minimum="0.6" Maximum="1.8" Value="1" TickFrequency=".1" ValueChanged="SpeedChanged"/></DockPanel></StackPanel></Grid></Border><Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Saved phrases" Style="{StaticResource SectionTitle}"/><TextBlock Text="No saved phrases yet — save current text to add one." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,6"/><ListBox x:Name="Phrases" Height="88" DisplayMemberPath="Name" MouseDoubleClick="PhraseSpeak"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Recent messages" Style="{StaticResource SectionTitle}"/><TextBlock Text="Double-click a message to speak it again." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,6"/><ListBox x:Name="History" Height="88" MouseDoubleClick="HistorySpeak"/></StackPanel></Grid></Border></Grid><DockPanel Grid.Row="7" Margin="2,16,2,0"><CheckBox x:Name="HideAfter" Content="Hide overlay after speaking" IsChecked="True" Foreground="{StaticResource Muted}"/><TextBlock DockPanel.Dock="Right" Text="Esc stops speech" Foreground="{StaticResource Muted}" FontSize="12"/></DockPanel></Grid></Window>
