<Window x:Class="FlickVox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlickVox" Icon="Assets/FlickVox.ico" Width="1000" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen" SizeChanged="WindowSizeChanged"
        Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text}"
        TextElement.Foreground="{DynamicResource Brush.Text}" UseLayoutRounding="True"
        SnapsToDevicePixels="True" PreviewKeyDown="WindowPreviewKeyDown"
        FontFamily="{StaticResource Font.UI}" TextOptions.TextFormattingMode="Ideal">
  <Grid Background="{DynamicResource Brush.Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Grid Margin="24,16,24,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource Brush.Brand}" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle Width="3" Height="8" Fill="White" Margin="1"/>
            <Rectangle Width="3" Height="14" Fill="White" Margin="1"/>
            <Rectangle Width="3" Height="6" Fill="White" Margin="1"/>
          </StackPanel>
        </Border>
        <TextBlock Text="FlickVox" FontFamily="{StaticResource Font.Brand}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Border Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="14" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Fill="{DynamicResource Brush.Signal}" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel x:Name="HotkeyHint" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
          <Border Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="6" Padding="6,3" Margin="0,0,4,0"><TextBlock Text="Ctrl" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/></Border>
          <Border Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="6" Padding="6,3" Margin="0,0,4,0"><TextBlock Text="Alt" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/></Border>
          <Border Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="6" Padding="6,3"><TextBlock Text="T" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/></Border>
        </StackPanel>
        <Button Click="OpenOverlay" ToolTip="Overlay · Ctrl+Alt+T" AutomationProperties.Name="Open overlay">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource Icon.Open}" Fill="{DynamicResource Brush.Text}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
            <TextBlock Text="Overlay" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource IconButton}" Click="OpenSettings" Margin="8,0,0,0"
                ToolTip="Settings" AutomationProperties.Name="Open settings">
          <Path Data="{StaticResource Icon.Settings}" Fill="{DynamicResource Brush.TextSecondary}" Width="20" Height="20" Stretch="Uniform"/>
        </Button>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="1200" HorizontalAlignment="Center" Margin="24,0,24,16">
        <Border x:Name="Notice" Visibility="Collapsed" Background="{DynamicResource Brush.SurfaceRaised}"
                BorderBrush="{DynamicResource Brush.StrokeControl}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,16">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>
            <Button x:Name="NoticeAction" Grid.Column="1" Content="Manage voices" Click="OpenVoiceManager" Margin="12,0,0,0" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <Grid x:Name="Workspace">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <StackPanel x:Name="ComposerColumn" Grid.Column="0" MinWidth="0">
            <Border x:Name="ComposerCard" MinHeight="190">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                  <Setter Property="CornerRadius" Value="18"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin,ElementName=Input}" Value="True">
                      <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentText}"/>
                      <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid><Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                <Grid>
                  <TextBox x:Name="Input" FontSize="22" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" KeyDown="InputKeyDown" TextChanged="InputChanged"
                           AutomationProperties.Name="Text to speak"/>
                  <TextBlock x:Name="InputPlaceholder" Text="Type something to say…" FontSize="22"
                             Foreground="{DynamicResource Brush.TextTertiary}" IsHitTestVisible="False"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Enter to speak  ·  Shift+Enter for new line" FontSize="12"
                             Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="Save" Click="SavePhrase" ToolTip="Save as phrase"
                            Height="28" Visibility="Collapsed" Margin="8,0,8,0"/>
                    <Button x:Name="ClearButton" Style="{StaticResource IconButton}" Height="28"
                            Click="ClearInput" ToolTip="Clear · Ctrl+L" AutomationProperties.Name="Clear text"
                            Visibility="Collapsed">
                      <Path Data="{StaticResource Icon.Dismiss}" Fill="{DynamicResource Brush.TextSecondary}" Width="20" Height="20" Stretch="Uniform"/>
                    </Button>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button x:Name="SpeakButton" Style="{StaticResource PrimaryButton}" Click="PrimaryAction">
                <StackPanel Orientation="Horizontal">
                  <Path x:Name="PrimaryIcon" Data="{StaticResource Icon.Play}" Fill="White" Width="20" Height="20" Margin="0,0,8,0"/>
                  <TextBlock x:Name="PrimaryLabel" Text="Speak" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="RepeatButton" Click="Repeat" IsEnabled="False" Margin="8,0,0,0"
                      ToolTip="Speak the last message again">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource Icon.ArrowRepeatAll}" Fill="{DynamicResource Brush.Text}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                  <TextBlock Text="Repeat" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <WrapPanel x:Name="ConfigurationChips" Margin="0,16,0,0" ItemHeight="44">
              <Grid Margin="0,0,8,8">
                <Button x:Name="VoiceChip" Style="{StaticResource Chip}" Click="ToggleVoiceFlyout" ToolTip="Choose voice">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.PersonVoice}" Fill="{DynamicResource Brush.TextSecondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock x:Name="VoiceValue" Text="Ryan · Medium" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                    <Path Data="{StaticResource Icon.ChevronDown}" Fill="{DynamicResource Brush.TextSecondary}" Width="12" Height="12" Stretch="Uniform" Margin="8,0,0,0"/>
                  </StackPanel>
                </Button>
                <Popup x:Name="VoiceFlyout" PlacementTarget="{Binding ElementName=VoiceChip}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" Opened="FlyoutOpened">
                  <Border Style="{StaticResource Flyout}" Width="300" Padding="16">
                    <StackPanel><TextBlock Text="Voice" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                      <ListBox x:Name="Voice" DisplayMemberPath="DisplayName" SelectionChanged="VoiceChanged"
                               MaxHeight="220" AutomationProperties.Name="Voice"/>
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Preview" Click="Preview"/>
                        <Button Content="Manage voices" Click="OpenVoiceManager" Margin="8,0,0,0"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Popup>
              </Grid>
              <Grid Margin="0,0,8,8">
                <Button x:Name="OutputChip" Style="{StaticResource Chip}" Click="ToggleOutputFlyout" ToolTip="Choose output device">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Speaker2}" Fill="{DynamicResource Brush.TextSecondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock x:Name="OutputValue" Text="Default output" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                    <Path Data="{StaticResource Icon.ChevronDown}" Fill="{DynamicResource Brush.TextSecondary}" Width="12" Height="12" Stretch="Uniform" Margin="8,0,0,0"/>
                  </StackPanel>
                </Button>
                <Popup x:Name="OutputFlyout" PlacementTarget="{Binding ElementName=OutputChip}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" Opened="FlyoutOpened">
                  <Border Style="{StaticResource Flyout}" Width="320" Padding="16">
                    <StackPanel><TextBlock Text="Output device" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                      <ListBox x:Name="Output" SelectionChanged="OutputChanged" MaxHeight="220"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Output device">
                        <ListBox.ItemTemplate><DataTemplate>
                          <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="264" ToolTip="{Binding}"/>
                        </DataTemplate></ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>
                </Popup>
              </Grid>
              <Grid Margin="0,0,8,8">
                <Button x:Name="SpeedChip" Style="{StaticResource Chip}" Click="ToggleSpeedFlyout" ToolTip="Adjust speech speed">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Timer}" Fill="{DynamicResource Brush.TextSecondary}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock x:Name="SpeedValue" Text="1.00×"/>
                    <Path Data="{StaticResource Icon.ChevronDown}" Fill="{DynamicResource Brush.TextSecondary}" Width="12" Height="12" Stretch="Uniform" Margin="8,0,0,0"/>
                  </StackPanel>
                </Button>
                <Popup x:Name="SpeedFlyout" PlacementTarget="{Binding ElementName=SpeedChip}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" Opened="FlyoutOpened">
                  <Border Style="{StaticResource Flyout}" Width="280" Padding="16">
                    <StackPanel><TextBlock Text="Speech speed" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                      <Slider x:Name="Speed" Minimum="0.6" Maximum="1.8" Value="1"
                              ValueChanged="SpeedChanged" AutomationProperties.Name="Speech speed"/>
                      <TextBlock x:Name="SpeedFlyoutValue" Text="1.00×" HorizontalAlignment="Right"
                                 Foreground="{DynamicResource Brush.AccentText}"/>
                    </StackPanel>
                  </Border>
                </Popup>
              </Grid>
            </WrapPanel>
          </StackPanel>

          <Border x:Name="Rail" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" MinHeight="180">
            <StackPanel>
              <Border Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="10" Padding="4" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="SavedTab" Style="{StaticResource TabButton}" Content="Saved" Click="ShowSaved"/>
                  <Button x:Name="RecentTab" Style="{StaticResource TabButton}" Content="Recent" Click="ShowRecent" Margin="4,0,0,0"/>
                </StackPanel>
              </Border>
              <StackPanel x:Name="SavedPanel" Margin="0,16,0,0">
                <TextBlock Text="Saved phrases" Style="{StaticResource SectionTitle}"/>
                <StackPanel x:Name="SavedEmpty" Margin="0,20,0,0" HorizontalAlignment="Center">
                  <Path Data="{StaticResource Icon.Bookmark}" Fill="{DynamicResource Brush.TextTertiary}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center"/>
                  <TextBlock Text="Save the things you say often." TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  <TextBlock Text="Type something, then select Save." Foreground="{DynamicResource Brush.TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <ListBox x:Name="Phrases" MouseDoubleClick="PhraseSpeak"
                         AutomationProperties.Name="Saved phrases" Margin="0,8,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate><DataTemplate>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="240" ToolTip="{Binding Text}"/>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              <StackPanel x:Name="RecentPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <TextBlock Text="Recent messages" Style="{StaticResource SectionTitle}"/>
                <StackPanel x:Name="RecentEmpty" Margin="0,20,0,0" HorizontalAlignment="Center">
                  <Path Data="{StaticResource Icon.History}" Fill="{DynamicResource Brush.TextTertiary}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center"/>
                  <TextBlock Text="Messages you speak will appear here." Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
                <ListBox x:Name="History" MouseDoubleClick="HistorySpeak"
                         AutomationProperties.Name="Recent messages" Margin="0,8,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate><DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="240" ToolTip="{Binding}"/>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="24,8,24,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <CheckBox x:Name="HideAfter" Style="{StaticResource ToggleSwitch}" Content="Hide overlay after speaking" IsChecked="True" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="Esc to stop speech" Foreground="{DynamicResource Brush.TextTertiary}"
                 VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>
  </Grid>
</Window>
