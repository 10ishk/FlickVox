<Window x:Class="FlickVox.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FlickVox" Width="1000" Height="640" MinWidth="560" MinHeight="480" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text}" TextElement.Foreground="{DynamicResource Brush.Text}" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
 <Grid Background="{DynamicResource Brush.Canvas}"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource Brush.Accent}" Margin="0,0,10,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Rectangle Width="3" Height="8" Fill="White" Margin="1"/><Rectangle Width="3" Height="13" Fill="White" Margin="1"/><Rectangle Width="3" Height="6" Fill="White" Margin="1"/></StackPanel></Border><TextBlock Text="FlickVox" FontSize="24" FontWeight="SemiBold"/><Border Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="14" Padding="10,4" Margin="14,0,0,0"><StackPanel Orientation="Horizontal"><Ellipse Fill="{DynamicResource Brush.Signal}" Width="8" Height="8" Margin="0,0,7,0"/><TextBlock x:Name="StatusText" Text="Ready" FontSize="13" VerticalAlignment="Center"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.StrokeSubtle}" BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="0,0,8,0"><TextBlock Text="Ctrl  Alt  T" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"/></Border><Button Content="Overlay" Click="OpenOverlay" ToolTip="Overlay · Ctrl+Alt+T" Margin="0,0,8,0"/><Button Style="{StaticResource IconButton}" ToolTip="Settings"><Path Data="M12,8A4,4 0 1,0 12,16A4,4 0 1,0 12,8M12,2V5M12,19V22M2,12H5M19,12H22" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="2"/></Button></StackPanel></Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MaxWidth="1200" Margin="24,0" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><StackPanel>
   <Border Style="{StaticResource Card}" CornerRadius="18" MinHeight="168"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions><Grid><TextBlock Text="Type something to say…" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="20" IsHitTestVisible="False" Margin="0,0,0,0" VerticalAlignment="Top"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Input}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Text,ElementName=Input}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="20" KeyDown="InputKeyDown" Background="Transparent"/></Grid><DockPanel Grid.Row="1"><TextBlock Text="Enter to speak   Shift+Enter for new line" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Save" Height="28" Click="SavePhrase" ToolTip="Save as phrase"/><Button Style="{StaticResource IconButton}" Height="28" Click="ClearInput" ToolTip="Clear · Ctrl+L"><Path Data="M7,7 L17,17 M17,7 L7,17" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="2"/></Button></StackPanel></DockPanel></Grid></Border>
   <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Click="Speak"><StackPanel Orientation="Horizontal"><Path Data="M8,5 L19,12 L8,19 Z" Fill="White" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Speak" Foreground="White"/></StackPanel></Button><Button Grid.Column="1" Content="Repeat" Click="Repeat" Margin="8,0,0,0"/><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><ComboBox x:Name="Voice" Width="150" DisplayMemberPath="DisplayName" SelectionChanged="VoiceChanged" ToolTip="Voice"/><ComboBox x:Name="Output" Width="170" Margin="8,0,0,0" ToolTip="Output device"/><Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.StrokeControl}" BorderThickness="1" CornerRadius="10" Padding="10,0" Height="40" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Speed" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,8,0"/><TextBlock x:Name="SpeedValue" Text="1.00x"/></StackPanel></Border></StackPanel></Grid>
   <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Speech settings" Style="{StaticResource SectionTitle}"/><TextBlock Text="Runs on your PC. Nothing is uploaded." Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Speech speed" Style="{StaticResource FieldLabel}"/><DockPanel><TextBlock x:Name="SpeedValue2" DockPanel.Dock="Right" Text="1.00x" Foreground="{DynamicResource Brush.AccentText}"/><Slider x:Name="Speed" Minimum="0.6" Maximum="1.8" Value="1" ValueChanged="SpeedChanged"/></DockPanel></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="Preview voice" Click="Preview"/><Button Content="Manage voices" Click="OpenVoiceManager" Margin="8,0,0,0"/></StackPanel></Grid></StackPanel></Border>
  </StackPanel><Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="SavedTab" Content="Saved" Click="ShowSaved"/><Button x:Name="RecentTab" Content="Recent" Click="ShowRecent" Margin="8,0,0,0"/></StackPanel><Grid Grid.Row="2"><StackPanel x:Name="SavedPanel"><TextBlock Text="Saved phrases" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SavedEmpty" Text="No saved phrases yet. Save messages you use frequently to access them faster." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,8"/><ListBox x:Name="Phrases" DisplayMemberPath="Name" MouseDoubleClick="PhraseSpeak"/></StackPanel><StackPanel x:Name="RecentPanel" Visibility="Collapsed"><TextBlock Text="Recent messages" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="RecentEmpty" Text="No recent messages. Messages you speak will appear here." TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,8"/><ListBox x:Name="History" MouseDoubleClick="HistorySpeak"/></StackPanel></Grid></Grid></Border></Grid></ScrollViewer>
  <Grid Grid.Row="2" Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="HideAfter" Content="Hide overlay after speaking" IsChecked="True" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Esc to stop speech" Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center"/></Grid>
 </Grid>
</Window>
