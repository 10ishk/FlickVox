<Window x:Class="FlickVox.VoiceManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Voice manager" Width="470" Height="420" WindowStartupLocation="CenterOwner"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListView x:Name="List"><ListView.View><GridView><GridViewColumn Header="Voice" Width="180" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding Size}"/></GridView></ListView.View></ListView><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="Progress" VerticalAlignment="Center"/><Button Content="Download / reinstall" Click="Download"/><Button Content="Remove" Click="Remove"/><Button Content="Close" Click="Close"/></StackPanel></Grid></Window>
