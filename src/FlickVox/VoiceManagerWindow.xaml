<Window x:Class="FlickVox.VoiceManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Voices" Width="720" Height="560" MinWidth="560" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text}" TextElement.Foreground="{DynamicResource Brush.Text}" WindowStartupLocation="CenterOwner"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Voices" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="All voices run on your PC. Nothing is sent online." Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0"/></StackPanel><Border Grid.Row="2" Style="{StaticResource Card}" Padding="12"><ListView x:Name="List" Background="Transparent" BorderThickness="0"><ListView.View><GridView><GridViewColumn Header="Voice" Width="260" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Quality" Width="130" DisplayMemberBinding="{Binding Size}"/><GridViewColumn Header="Status" Width="150" DisplayMemberBinding="{Binding Status}"/></GridView></ListView.View></ListView></Border><DockPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="Progress" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" MinWidth="0" Content="Download / reinstall" Click="Download"/><Button Content="Remove" Click="Remove" Margin="8,0,0,0"/><Button Content="Close" Click="Close" Margin="8,0,0,0"/></StackPanel></DockPanel></Grid></Window>
