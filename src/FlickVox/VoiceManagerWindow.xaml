<Window x:Class="FlickVox.VoiceManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Voice manager" Width="620" Height="500" MinWidth="520" WindowStartupLocation="CenterOwner"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Voice manager" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Download and manage the six supported offline Piper voices." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><Border Grid.Row="2" Style="{StaticResource Card}" Padding="8"><ListView x:Name="List" Background="Transparent" BorderThickness="0"><ListView.View><GridView><GridViewColumn Header="Voice" Width="225" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Quality" Width="100" DisplayMemberBinding="{Binding Size}"/><GridViewColumn Header="Status" Width="120" DisplayMemberBinding="{Binding Status}"/></GridView></ListView.View></ListView></Border><DockPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="Progress" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Download / reinstall" Click="Download"/><Button Content="Remove" Click="Remove" Margin="8,0,0,0"/><Button Content="Close" Click="Close" Margin="8,0,0,0"/></StackPanel></DockPanel></Grid></Window>
