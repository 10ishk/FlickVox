<Window x:Class="FlickVox.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlickVox Settings" Icon="Assets/FlickVox.ico" Width="760" Height="590"
        MinWidth="600" MinHeight="440" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text}"
        TextElement.Foreground="{DynamicResource Brush.Text}" PreviewKeyDown="WindowKeyDown">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Changes are saved automatically." Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="Sections" SelectionChanged="SectionChanged" AutomationProperties.Name="Settings sections">
        <ListBoxItem Content="General"/><ListBoxItem Content="Voice &amp; audio"/>
        <ListBoxItem Content="Overlay"/><ListBoxItem Content="Appearance"/>
        <ListBoxItem Content="Accessibility"/><ListBoxItem Content="About"/>
      </ListBox>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid>
            <StackPanel x:Name="GeneralPanel">
              <TextBlock Text="General" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <CheckBox x:Name="HideAfter" Style="{StaticResource ToggleSwitch}" Content="Hide the overlay after submitting speech"
                        Checked="HideAfterChanged" Unchecked="HideAfterChanged"/>
              <TextBlock Text="When off, the overlay stays available for another message."
                         Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel x:Name="AudioPanel" Visibility="Collapsed">
              <TextBlock Text="Voice &amp; audio" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock Text="Default voice" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="Voice" DisplayMemberPath="DisplayName" SelectionChanged="VoiceChanged" Margin="0,8,0,16"/>
              <TextBlock Text="Output device" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="Output" SelectionChanged="OutputChanged" Margin="0,8,0,16">
                <ComboBox.ItemTemplate><DataTemplate>
                  <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="300" ToolTip="{Binding}"/>
                </DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Speech speed" Style="{StaticResource FieldLabel}"/>
              <Slider x:Name="Speed" Minimum="0.6" Maximum="1.8" ValueChanged="SpeedChanged" Margin="0,8,0,4"/>
              <TextBlock x:Name="SpeedValue" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,16"/>
              <TextBlock Text="Volume" Style="{StaticResource FieldLabel}"/>
              <Slider x:Name="Volume" Minimum="0" Maximum="1" ValueChanged="VolumeChanged" Margin="0,8,0,4"/>
              <TextBlock x:Name="VolumeValue" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.AccentText}"/>
            </StackPanel>
            <StackPanel x:Name="OverlayPanel" Visibility="Collapsed">
              <TextBlock Text="Overlay" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <CheckBox x:Name="AlwaysOnTop" Style="{StaticResource ToggleSwitch}" Content="Keep overlay above other windows"
                        Checked="AlwaysOnTopChanged" Unchecked="AlwaysOnTopChanged" Margin="0,0,0,16"/>
              <TextBlock Text="Overlay width" Style="{StaticResource FieldLabel}"/>
              <Slider x:Name="OverlayWidth" Minimum="420" Maximum="800" TickFrequency="20"
                      ValueChanged="OverlayWidthChanged" Margin="0,8,0,4"/>
              <TextBlock x:Name="OverlayWidthValue" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.AccentText}"/>
              <Button Content="Reset overlay position" Click="ResetOverlayPosition" HorizontalAlignment="Left" Margin="0,16,0,0"/>
              <TextBlock Text="The global shortcut is Ctrl + Alt + T."
                         Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,16,0,0"/>
            </StackPanel>
            <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
              <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="Theme" SelectionChanged="ThemeChanged" Margin="0,8,0,16">
                <ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="System"/>
              </ComboBox>
              <TextBlock Text="Composer font" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="ComposerFont" SelectionChanged="ComposerFontChanged" Margin="0,8,0,16">
                <ComboBoxItem Content="Inter"/><ComboBoxItem Content="Atkinson Hyperlegible"/><ComboBoxItem Content="System"/>
              </ComboBox>
              <TextBlock Text="Composer text size" Style="{StaticResource FieldLabel}"/>
              <Slider x:Name="ComposerSize" Minimum="16" Maximum="40" TickFrequency="1"
                      ValueChanged="ComposerSizeChanged" Margin="0,8,0,4"/>
              <TextBlock x:Name="ComposerSizeValue" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.AccentText}"/>
            </StackPanel>
            <StackPanel x:Name="AccessibilityPanel" Visibility="Collapsed">
              <TextBlock Text="Accessibility" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock Text="FlickVox follows Windows High Contrast when it is enabled."
                         TextWrapping="Wrap" Margin="0,0,0,12"/>
              <TextBlock Text="Controls show keyboard focus. Status changes are announced to screen readers."
                         Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
              <TextBlock Text="About FlickVox" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <TextBlock Text="Version 0.1.0" Margin="0,0,0,8"/>
              <TextBlock Text="Offline speech powered by Piper. Speech is generated on your PC."
                         TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock Text="FlickVox source code is MIT licensed. Third-party licenses are listed in THIRD_PARTY_NOTICES.md."
                         Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
    <Button Grid.Row="3" Content="Close" Click="Close" HorizontalAlignment="Right" Margin="0,16,0,0"/>
  </Grid>
</Window>
