<Window x:Class="FlickVox.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlickVox Settings" Icon="Assets/FlickVox.ico" Width="680" Height="480"
        MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text}"
        TextElement.Foreground="{DynamicResource Brush.Text}" PreviewKeyDown="WindowKeyDown">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibility"/></Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Changes are saved automatically." Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="Sections" SelectionChanged="SectionChanged" AutomationProperties.Name="Settings sections">
        <ListBoxItem Content="General"/><ListBoxItem Content="Voice &amp; audio"/>
        <ListBoxItem Content="Compact window"/><ListBoxItem Content="Appearance"/>
        <ListBoxItem Content="Accessibility"/><ListBoxItem Content="About"/>
      </ListBox>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid>
            <StackPanel x:Name="GeneralPanel">
              <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <CheckBox x:Name="HideAfter" Style="{StaticResource ToggleSwitch}" Content="Hide quick pill when speech starts"
                        Checked="HideAfterChanged" Unchecked="HideAfterChanged"/>
              <TextBlock Text="Speech continues in the background. Reopen the pill to stop it. On errors or cancellation, your draft is preserved. When off, the pill stays open."
                         Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
              <CheckBox x:Name="PersistHistory" Style="{StaticResource ToggleSwitch}" Content="Keep recent messages between sessions"
                        Checked="PersistHistoryChanged" Unchecked="PersistHistoryChanged" Margin="0,18,0,0"/>
              <TextBlock Text="Off by default. Existing messages stay in memory until you exit."
                         Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel x:Name="AudioPanel" Visibility="Collapsed">
              <TextBlock Text="Voice &amp; audio" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock Text="Default voice" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="Voice" DisplayMemberPath="DisplayName" SelectionChanged="VoiceChanged" Margin="0,5,0,14"/>
              <TextBlock Text="Output device" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="Output" SelectionChanged="OutputChanged" Margin="0,5,0,14">
                <ComboBox.ItemTemplate><DataTemplate>
                  <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="300" ToolTip="{Binding}"/>
                </DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="Speech speed" Style="{StaticResource FieldLabel}"/>
              <Slider x:Name="Speed" Minimum="0.6" Maximum="1.8" ValueChanged="SpeedChanged" Margin="0,5,0,2"/>
              <TextBlock x:Name="SpeedValue" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,0,14"/>
              <TextBlock Text="Volume" Style="{StaticResource FieldLabel}"/>
              <Slider x:Name="Volume" Minimum="0" Maximum="1" ValueChanged="VolumeChanged" Margin="0,5,0,2"/>
              <TextBlock x:Name="VolumeValue" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.AccentText}"/>
              <TextBlock Text="For Discord or games, route this output through a virtual audio device (such as Wave Link) and select that device as the microphone in the other app."
                         Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
            <StackPanel x:Name="CompactPanel" Visibility="Collapsed">
              <TextBlock Text="Compact window" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <CheckBox x:Name="AlwaysOnTop" Style="{StaticResource ToggleSwitch}" Content="Keep FlickVox above other windows"
                        Checked="AlwaysOnTopChanged" Unchecked="AlwaysOnTopChanged" Margin="0,0,0,16"/>
              <TextBlock Text="Quick pill width" Style="{StaticResource FieldLabel}"/>
              <Slider x:Name="QuickPillWidth" Minimum="320" Maximum="800" TickFrequency="20"
                      ValueChanged="QuickPillWidthChanged" Margin="0,8,0,4"/>
              <TextBlock x:Name="QuickPillWidthValue" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.AccentText}"/>
              <Button Content="Reset window position" Click="ResetWindowPosition" HorizontalAlignment="Left" Margin="0,16,0,0"/>
              <TextBlock Text="Global quick-pill shortcut" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
              <ComboBox x:Name="Hotkey" IsEditable="True" SelectionChanged="HotkeyChanged" LostFocus="HotkeyLostFocus" Margin="0,6,0,0"
                        AutomationProperties.Name="Global quick-pill shortcut">
                <ComboBoxItem Content="Ctrl+Alt+T"/><ComboBoxItem Content="Ctrl+Alt+V"/><ComboBoxItem Content="Ctrl+Shift+T"/>
              </ComboBox>
              <TextBlock x:Name="HotkeyError" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed"/>
              <TextBlock Text="Use Ctrl or Alt plus a letter or F1–F12. If unavailable, the previous shortcut remains active."
                         Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
              <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
              <ItemsControl x:Name="ThemeSwatches" Margin="0,7,0,9">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Tag="{Binding Name}" Click="PickTheme" Width="108" Height="68" Padding="0" Margin="0,0,6,6"
                          ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Hint}" Background="Transparent">
                    <Border Background="{Binding Background}" BorderBrush="{Binding Outline}" BorderThickness="2" CornerRadius="8" Padding="6" Width="106" Height="66">
                      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                          <Border Width="13" Height="13" Background="{Binding Surface}" BorderBrush="{Binding Accent}" BorderThickness="1" CornerRadius="3" Margin="0,0,3,0"/>
                          <Border Width="13" Height="13" Background="{Binding Accent}" CornerRadius="3"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="{Binding PreviewText}" FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                        <TextBlock Text="✓" Foreground="{Binding Accent}" FontWeight="Bold" FontSize="14"
                                   Visibility="{Binding Selected, Converter={StaticResource BooleanToVisibility}}"/>
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Composer font" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="ComposerFont" SelectionChanged="ComposerFontChanged" Margin="0,5,0,14">
                <ComboBoxItem Content="Inter"/><ComboBoxItem Content="Atkinson Hyperlegible"/><ComboBoxItem Content="System"/>
              </ComboBox>
              <TextBlock Text="Composer text size" Style="{StaticResource FieldLabel}"/>
              <Slider x:Name="ComposerSize" Minimum="16" Maximum="40" TickFrequency="1"
                      ValueChanged="ComposerSizeChanged" Margin="0,8,0,4"/>
              <TextBlock x:Name="ComposerSizeValue" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.AccentText}"/>
            </StackPanel>
            <StackPanel x:Name="AccessibilityPanel" Visibility="Collapsed">
              <TextBlock Text="Accessibility" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock Text="FlickVox follows Windows High Contrast when it is enabled."
                         TextWrapping="Wrap" Margin="0,0,0,12"/>
              <TextBlock Text="Controls show keyboard focus. Status changes are announced to screen readers."
                         Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
              <TextBlock Text="About FlickVox" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock Text="Version 0.1.0" Margin="0,0,0,8"/>
              <TextBlock Text="Offline speech powered by Piper. Speech is generated on your PC."
                         TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock Text="FlickVox source code is MIT licensed. Third-party licenses are listed in THIRD_PARTY_NOTICES.md."
                         Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
    <Button Grid.Row="3" Content="Close" Click="Close" HorizontalAlignment="Right" Margin="0,10,0,0"/>
  </Grid>
</Window>
