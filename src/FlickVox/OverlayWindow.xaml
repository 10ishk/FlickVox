<Window x:Class="FlickVox.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="640" Height="80" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent" Topmost="True"><Border Margin="12" Background="{DynamicResource Brush.OverlayBg}" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="18" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" ToolTip="Drag overlay" MouseLeftButtonDown="Drag"><Rectangle Width="3" Height="3" Fill="{DynamicResource Brush.TextTertiary}" Margin="1"/><Rectangle Width="3" Height="3" Fill="{DynamicResource Brush.TextTertiary}" Margin="1"/><Rectangle Width="3" Height="3" Fill="{DynamicResource Brush.TextTertiary}" Margin="1"/></StackPanel><Grid Grid.Column="1"><TextBlock x:Name="Placeholder" Text="Type to speak…" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="18" IsHitTestVisible="False" VerticalAlignment="Center"/><TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Center" FontSize="18" KeyDown="KeyDownHandler" TextChanged="InputChanged" Background="Transparent"/></Grid><Border Grid.Column="2" Background="{DynamicResource Brush.SurfaceRaised}" CornerRadius="6" Padding="7,3" VerticalAlignment="Center"><TextBlock Text="Esc" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"/></Border></Grid></Border></Window>
