<Window x:Class="FlickVox.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/FlickVox.ico" Width="520" Height="72" MinWidth="420"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        FontFamily="{StaticResource Font.UI}" TextElement.Foreground="{DynamicResource Brush.Text}">
  <Border x:Name="Shell" Margin="8" CornerRadius="18" Padding="12,0"
          Background="{DynamicResource Brush.OverlayBg}" BorderBrush="{DynamicResource Brush.StrokeControl}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition x:Name="InputRow" Height="55"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="18" Height="30" Background="Transparent" MouseLeftButtonDown="Drag"
                ToolTip="Drag overlay" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel><Ellipse Fill="{DynamicResource Brush.TextTertiary}" Width="3" Height="3" Margin="2"/><Ellipse Fill="{DynamicResource Brush.TextTertiary}" Width="3" Height="3" Margin="2"/></StackPanel>
            <StackPanel><Ellipse Fill="{DynamicResource Brush.TextTertiary}" Width="3" Height="3" Margin="2"/><Ellipse Fill="{DynamicResource Brush.TextTertiary}" Width="3" Height="3" Margin="2"/></StackPanel>
          </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="7,0,0,0">
          <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Center"
                   VerticalScrollBarVisibility="Auto" FontSize="18" Background="Transparent"
                   KeyDown="KeyDownHandler" TextChanged="InputChanged" AutomationProperties.Name="Overlay text to speak"/>
          <TextBlock x:Name="Placeholder" Text="Type to speak…" FontSize="18" Foreground="{DynamicResource Brush.TextTertiary}"
                     VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
          <Ellipse x:Name="StateDot" Fill="{DynamicResource Brush.Signal}" Width="6" Height="6" Margin="0,0,5,0"/>
          <TextBlock x:Name="StateText" Text="Ready" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"
                     VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Button x:Name="ExpandButton" Grid.Column="3" Content="▾" Click="ToggleExpanded" Margin="7,0,0,0"
                ToolTip="Expand overlay" AutomationProperties.Name="Expand overlay" VerticalAlignment="Center" Padding="5,2"/>
      </Grid>
      <ScrollViewer x:Name="ExpandedContent" Grid.Row="1" Visibility="Collapsed" Margin="4,6,4,10"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="Voice and output" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,6"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="Voice" DisplayMemberPath="DisplayName" SelectionChanged="VoiceChanged" AutomationProperties.Name="Overlay voice"/>
          <ComboBox x:Name="Output" Grid.Column="1" SelectionChanged="OutputChanged" Margin="6,0,0,0" AutomationProperties.Name="Overlay output"/>
        </Grid>
        <Grid Margin="0,9,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Enter to speak · Shift+Enter for new line" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Button x:Name="SpeakButton" Grid.Column="1" Content="Speak" Style="{StaticResource PrimaryButton}" Click="SpeakOrStop"/>
        </Grid>
        <Button Content="Save current text" Click="SavePhrase" HorizontalAlignment="Left" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
          <Button x:Name="SavedTab" Content="Saved" Click="ShowSaved"/>
          <Button x:Name="RecentTab" Content="Recent" Click="ShowRecent" Margin="4,0,0,0"/>
        </StackPanel>
        <Grid MaxHeight="132">
          <StackPanel x:Name="SavedPanel">
            <TextBlock x:Name="SavedEmpty" Text="No saved phrases yet." Foreground="{DynamicResource Brush.TextSecondary}"/>
            <ListBox x:Name="Phrases" AutomationProperties.Name="Overlay saved phrases">
              <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" ToolTip="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Play" Tag="{Binding}" Click="PlayPhrase" Margin="4,0,0,0"/>
                <Button Grid.Column="2" Content="Edit" Tag="{Binding}" Click="EditPhrase" Margin="4,0,0,0"/>
                <Button Grid.Column="3" Content="Delete" Tag="{Binding}" Click="DeletePhrase" Margin="4,0,0,0"/>
              </Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          <StackPanel x:Name="RecentPanel" Visibility="Collapsed">
            <TextBlock x:Name="RecentEmpty" Text="No recent messages yet." Foreground="{DynamicResource Brush.TextSecondary}"/>
            <ListBox x:Name="History" AutomationProperties.Name="Overlay recent messages">
              <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Play" Tag="{Binding}" Click="PlayHistory"/>
              </Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>
      </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
