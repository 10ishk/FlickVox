<Window x:Class="FlickVox.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/FlickVox.ico" Width="640" Height="80" MinWidth="420"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        FontFamily="{StaticResource Font.UI}" TextElement.Foreground="{DynamicResource Brush.Text}">
  <Border x:Name="Shell" Margin="12" CornerRadius="18" Padding="16,0"
          Background="{DynamicResource Brush.OverlayBg}"
          BorderBrush="{DynamicResource Brush.StrokeControl}" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Width="18" Height="32" Background="Transparent"
              MouseLeftButtonDown="Drag" ToolTip="Drag overlay" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel><Ellipse Fill="{DynamicResource Brush.TextTertiary}" Width="3" Height="3" Margin="2"/>
            <Ellipse Fill="{DynamicResource Brush.TextTertiary}" Width="3" Height="3" Margin="2"/></StackPanel>
          <StackPanel><Ellipse Fill="{DynamicResource Brush.TextTertiary}" Width="3" Height="3" Margin="2"/>
            <Ellipse Fill="{DynamicResource Brush.TextTertiary}" Width="3" Height="3" Margin="2"/></StackPanel>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="8,0,0,0">
        <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Center" VerticalScrollBarVisibility="Auto"
                 FontSize="20" Background="Transparent" KeyDown="KeyDownHandler"
                 TextChanged="InputChanged" AutomationProperties.Name="Overlay text to speak"/>
        <TextBlock x:Name="Placeholder" Text="Type to speak…" FontSize="20"
                   Foreground="{DynamicResource Brush.TextTertiary}"
                   VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
        <Ellipse x:Name="StateDot" Fill="{DynamicResource Brush.Signal}" Width="6" Height="6" Margin="0,0,6,0"/>
        <TextBlock x:Name="StateText" Text="Ready" Foreground="{DynamicResource Brush.TextSecondary}"
                   FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
