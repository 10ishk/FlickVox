<Window x:Class="FlickVox.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up FlickVox speech" Icon="Assets/FlickVox.ico" Width="470" Height="385"
        MinWidth="400" MinHeight="340" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.Text}"
        TextElement.Foreground="{DynamicResource Brush.Text}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <TextBlock Text="Set up speech" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="Piper and a voice run locally on your PC. Existing downloads will be reused."
                 Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,15"/>
      <TextBlock x:Name="RuntimeState" Margin="0,0,0,7"/>
      <Button x:Name="InstallButton" Content="Download official Piper runtime" Click="InstallRuntime" HorizontalAlignment="Left"/>
      <TextBlock x:Name="VoiceState" Margin="0,16,0,7"/>
      <Button Content="Manage voices" Click="ManageVoices" HorizontalAlignment="Left"/>
      <TextBlock Text="Choose an output in Settings. For voice chat, select a virtual audio device and use it as the microphone in your chat app."
                 Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,16,0,8"/>
      <Button Content="Open audio settings" Click="AudioSettings" HorizontalAlignment="Left"/>
      <Button x:Name="TestButton" Content="Play a test phrase" Click="TestSpeech" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      <Button x:Name="HeardButton" Content="I heard the test phrase" Click="ConfirmSpeech" IsEnabled="False" HorizontalAlignment="Left" Margin="0,6,0,0"/>
      <TextBlock x:Name="SetupStatus" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="Skip for now" Click="Skip" Margin="0,0,6,0"/>
        <Button Content="Close" Click="Close"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
