<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="Brush.Canvas" Color="#FF0F1218"/><SolidColorBrush x:Key="Brush.Surface" Color="#FF161A22"/><SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#FF1D222C"/><SolidColorBrush x:Key="Brush.SurfaceHover" Color="#FF252B37"/><SolidColorBrush x:Key="Brush.StrokeSubtle" Color="#FF262D39"/><SolidColorBrush x:Key="Brush.StrokeControl" Color="#FF65718A"/><SolidColorBrush x:Key="Brush.Text" Color="#FFEEF1F6"/><SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFA9B2C1"/><SolidColorBrush x:Key="Brush.TextTertiary" Color="#FF8592A5"/><SolidColorBrush x:Key="Brush.Accent" Color="#FF4F46E5"/><SolidColorBrush x:Key="Brush.AccentHover" Color="#FF5B54F0"/><SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF4338CA"/><SolidColorBrush x:Key="Brush.AccentText" Color="#FFA5ADFF"/><SolidColorBrush x:Key="Brush.Signal" Color="#FF3DDBB5"/><SolidColorBrush x:Key="Brush.OverlayBg" Color="#F012161C"/><SolidColorBrush x:Key="Background" Color="#FF0F1218"/><SolidColorBrush x:Key="Surface" Color="#FF161A22"/><SolidColorBrush x:Key="SurfaceRaised" Color="#FF1D222C"/><SolidColorBrush x:Key="Border" Color="#FF65718A"/><SolidColorBrush x:Key="Accent" Color="#FF4F46E5"/><SolidColorBrush x:Key="Text" Color="#FFEEF1F6"/><SolidColorBrush x:Key="Muted" Color="#FF8592A5"/>
 <Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource Brush.Canvas}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/><Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Brush.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeSubtle}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/></Style><Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/></Style>
 <Style TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="16,0"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/><Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeControl}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Focus" Margin="-3" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent"/><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".78"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource Brush.AccentText}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="44"/><Setter Property="MinWidth" Value="140"/><Setter Property="Background" Value="{DynamicResource Brush.Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/><Setter Property="Foreground" Value="White"/></Style><Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
 <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CaretBrush" Value="{DynamicResource Brush.AccentText}"/><Setter Property="SelectionBrush" Value="#664F46E5"/></Style>
 <Style TargetType="ToggleButton"><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleBody" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBody" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleBody" Property="BorderBrush" Value="{DynamicResource Brush.AccentText}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/><Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/><Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#334F46E5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox"><Setter Property="Height" Value="40"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/><Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeControl}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Focusable="False"><Grid><ContentPresenter Margin="12,0,36,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Path Data="M 0 0 L 10 0 L 5 6 Z" Fill="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Grid></ToggleButton><Popup IsOpen="{Binding IsChecked,ElementName=Toggle}" Placement="Bottom" AllowsTransparency="True"><Border Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.StrokeControl}" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0" MinWidth="{Binding ActualWidth,ElementName=Toggle}"><ScrollViewer MaxHeight="240"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style><Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/></Style><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,2"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/></Style>
</ResourceDictionary>
