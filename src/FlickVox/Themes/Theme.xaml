<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
 <Color x:Key="SurfaceColor">#FF20242B</Color><Color x:Key="PanelColor">#FF2A3039</Color><Color x:Key="AccentColor">#FF60A5FA</Color>
 <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/><SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/><SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/><SolidColorBrush x:Key="Text" Color="#FFF4F7FB"/><SolidColorBrush x:Key="Muted" Color="#FFB0BAC9"/>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
 <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#556B7280"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#556B7280"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/></Style>
</ResourceDictionary>
